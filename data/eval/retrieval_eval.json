{
  "version": "1.0",
  "about": "检索评估标注集。每条标注给出一个查询与「人工判定应当被检索到的实体」。标注独立于检索器的实际输出：先定答案，再跑评估，避免拿结果反推标准。",
  "grading": {
    "3": "直接答案——该实体本身就是这条查询要问的对象",
    "2": "高度相关——与查询主题直接相关，可作补充依据",
    "1": "弱相关——同族/同域，回答时可参考但非必需",
    "0": "不相关（不写入标注，作为隐含的负例）"
  },
  "tags": {
    "专名": "查询词就是实体名称",
    "别名": "查询词是实体的别名或俗称，考察别名召回",
    "关系": "问实体之间的关系或归属，答案为「主实体 + 对象实体」",
    "属性": "问实体的某项属性或旧称",
    "概念": "问一类事物的内涵或包含范围，通常有多个相关实体",
    "负样本": "数据集中确实没有相关知识，检索器应返回空列表",
    "词面重叠": "负样本中的某个词与语料里的实体字面重叠，属于已知的困难样本"
  },
