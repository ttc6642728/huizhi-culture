# =========================================================
# 徽知 · Huizhou Culture Explorer  配置示例
# ---------------------------------------------------------
# 使用方式：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 忽略，绝不会进入代码仓库。
#
# 问答后端按「Dify -> OpenAI 兼容大模型 -> 本地检索式」顺序自动降级：
#   只填 A 区块 -> 走 Dify
#   只填 B 区块 -> 走通用大模型
#   A、B 都不填 -> 自动走本地检索式（纯离线，无需任何配置）
# =========================================================

# ---------- 方案 A：自建 Dify（优先级最高）----------
DIFY_BASE_URL=
DIFY_API_KEY=
# chat | completion | workflow
DIFY_APP_TYPE=chat
DIFY_TIMEOUT=60

# ---------- 方案 B：OpenAI 兼容大模型 ----------
# 任何 OpenAI 兼容接口均可（DeepSeek / 通义千问 / 智谱 / OpenAI ...）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---------- 方案 C：本地检索式（兜底，无需配置）----------
# 置为 true 可强制使用本地检索式，便于离线演示与测试对比
QA_FORCE_LOCAL=false
# 检索返回的资料片段数量
QA_TOP_K=5

# ---------- 应用配置 ----------
APP_TITLE=徽知 · Huizhou Culture Explorer
